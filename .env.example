# Kopjoje si .env vetem per referen; ne Render/Railway keto vendosen si
# Environment Variables ne dashboard, jo si file .env ne repo.

# --- Databaza (nga Railway MySQL) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=myplatform

# --- Stripe ---
STRIPE_SECRET_KEY=

# --- URL bazë e aplikacionit (domain-i i vertete, pa slash ne fund) ---
# p.sh. https://eagledrop.com
APP_BASE_URL=

# --- SMTP (Gmail App Password) ---
SMTP_USERNAME=
SMTP_PASSWORD=

# --- CRM webhook (opsionale) ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
